{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edit decision",
  "type": "object",
  "required": [
    "shot_id",
    "timebase",
    "in_seconds",
    "out_seconds",
    "reason",
    "status"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "string",
      "minLength": 1
    },
    "in_seconds": {
      "type": "number",
      "minimum": 0
    },
    "out_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source_in_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source_out_seconds": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "observed",
        "verified",
        "unknown"
      ]
    }
  },
  "additionalProperties": true
}
