{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character",
  "type": "object",
  "required": [
    "character_id",
    "objective",
    "values",
    "behavior"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backstory": {
      "type": "string",
      "minLength": 1
    },
    "wardrobe_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_reference_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "observed",
        "verified",
        "unknown"
      ]
    }
  },
  "additionalProperties": true
}
