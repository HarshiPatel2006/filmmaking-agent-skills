{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Location",
  "type": "object",
  "required": [
    "location_id",
    "description",
    "fixed_landmarks"
  ],
  "properties": {
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixed_landmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entrances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "layout_notes": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "observed",
        "verified",
        "unknown"
      ]
    }
  },
  "additionalProperties": true
}
